# Copy to .env (local dev) — never commit the real file.
# See apps/web/lib/env.ts for validation and docs/plan.md §22 for rationale.

# NODE_ENV is set automatically by whichever command runs (next dev/build/
# start, vitest, etc.) — do NOT set it here. Forcing it via a blanket .env
# injection makes `next build` load development-mode React into a
# production bundle and breaks in confusing ways.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (packages/db, Phase 1) ---------------------------------------
# Local Docker Postgres from docker/docker-compose.yml:
DATABASE_URL=postgresql://medivi:medivi@localhost:5432/medivi_shop

# --- Auth: Better Auth (Phase 2) --------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Payments (Phase 5) ------------------------------------------------------
# "mock" needs no keys and is the default for local dev/CI/E2E.
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (Phase 8) --------------------------------------------------------
# "console" logs the rendered email instead of sending — default for local dev.
EMAIL_PROVIDER=console
RESEND_API_KEY=
# Only needed when EMAIL_PROVIDER=resend — Resend requires a verified sending domain.
EMAIL_FROM=Medivi Shop <no-reply@medivi.shop>

# --- File storage (Phase 7 admin uploads) -----------------------------------
# "s3" targets the local MinIO container from docker/docker-compose.yml.
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=medivi
S3_SECRET_ACCESS_KEY=medivi-local-dev
S3_BUCKET=medivi-shop
# Only needed when STORAGE_PROVIDER=vercel-blob:
BLOB_READ_WRITE_TOKEN=

# --- Cache / rate limiting (Phase 10) ---------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Observability (Phase 10) -----------------------------------------------
# Server-side error reporting. Leave unset to disable (no-op in local dev/CI).
SENTRY_DSN=
# Client-side error reporting — must be NEXT_PUBLIC_ to reach the browser bundle.
# Usually the same DSN as SENTRY_DSN above.
NEXT_PUBLIC_SENTRY_DSN=
