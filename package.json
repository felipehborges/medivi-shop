{
  "name": "medivi-shop",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.14.0",
  "scripts": {
    "dev": "pnpm dev:demo",
    "dev:demo": "pnpm --filter @medivi/demo dev",
    "dev:web": "pnpm --filter @medivi/web dev",
    "build": "pnpm --filter @medivi/demo build",
    "lint": "pnpm --filter @medivi/ui lint && pnpm --filter @medivi/demo lint",
    "typecheck": "pnpm --filter @medivi/ui typecheck && pnpm --filter @medivi/demo typecheck",
    "test": "pnpm --filter @medivi/demo test",
    "test:e2e": "pnpm --filter @medivi/demo test:e2e",
    "build:demo": "pnpm --filter @medivi/demo build",
    "legacy:build": "pnpm --filter @medivi/web build",
    "legacy:db:migrate": "pnpm --filter @medivi/db db:migrate",
    "legacy:db:seed": "pnpm --filter @medivi/db db:seed",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.11.3",
    "typescript": "^7.0.2"
  }
}
