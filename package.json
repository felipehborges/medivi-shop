{
  "name": "medivi-shop",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.14.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:demo": "pnpm --filter @medivi/demo dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "build:demo": "pnpm --filter @medivi/demo build",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.10.13",
    "typescript": "^7.0.2"
  }
}
